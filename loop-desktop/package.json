{
  "name": "loop-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:${VITE_DEV_PORT:-5173} && VITE_DEV_SERVER_URL=http://localhost:${VITE_DEV_PORT:-5173} electron electron/main.cjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --test test/activity-stores.test.ts test/combined-patch.test.ts test/worktree-draft.test.ts test/draft-conversation-submit.test.ts",
    "test:e2e:ssh": "node --test test/ssh-tunnel.test.mjs",
    "preview": "vite preview",
    "start": "npm run build && electron electron/main.cjs"
  },
  "dependencies": {
    "@types/morphdom": "^2.3.0",
    "dompurify": "^3.3.2",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.4",
    "morphdom": "^2.7.8",
    "react": "^19.2.0",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-scan": "^0.5.3",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
